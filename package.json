{
  "name": "prettylogs",
  "version": "0.1.0",
  "description": "Terminal-first developer log viewer",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "prettylogs": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
